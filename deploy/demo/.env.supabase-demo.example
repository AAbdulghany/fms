# Copy to deploy/demo/.env.supabase-demo and fill in.
# Never commit deploy/demo/.env.supabase-demo
#
# Usage:
#   docker compose -f docker-compose-supabase-demo.yml --env-file deploy/demo/.env.supabase-demo up -d --build

# Prefer direct host from Docker Desktop if pooler DNS fails:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# URL-encode special characters in the password (e.g. ) → %29)
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

APP_ENV=demo
SEED_MODULE=pitch

PUBLIC_APP_URL=https://demo.orbittech.co
CORS_ORIGINS=https://demo.orbittech.co
