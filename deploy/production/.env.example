# Production — copy to deploy/production/.env on the server.
# Never commit real secrets.

APP_ENV=production
SECRET_KEY=replace-with-openssl-or-secrets-token-hex-32
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/fms_prod
PUBLIC_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# SMTP / object storage / etc. — fill per ops runbook
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=
