# Copy to deploy/pilot/.env.supabase and fill in.
# Never commit deploy/pilot/.env.supabase
#
# Usage:
#   docker compose -f docker-compose-pilot-supabase.yml --env-file deploy/pilot/.env.supabase up -d --build

DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

SECRET_KEY=replace-me
APP_ENV=pilot
SEED_MODULE=pilot

PUBLIC_APP_URL=https://demo.orbittech.co
CORS_ORIGINS=https://demo.orbittech.co
