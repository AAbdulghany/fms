# Copy to deploy/pilot/.env.supabase (local) or merge into deploy/pilot/.env (live VM).
# Never commit real secrets.
#
# Local:
#   docker compose -f docker-compose-pilot-supabase.yml \
#     --env-file deploy/pilot/.env.supabase up -d --build
#
# Live VM (canonical always-on pilot):
#   docker compose -f docker-compose-pilot-supabase.yml \
#     -f deploy/pilot/docker-compose.live-supabase.yml \
#     --env-file deploy/pilot/.env up -d --build
#
# Supabase: Settings → Database → Connection string
# - Runtime API: Transaction pooler (port 6543)
# - Migrations: Session mode or Direct (port 5432) — more reliable for Alembic DDL
# Convert postgresql:// → postgresql+psycopg2:// and URL-encode special chars in the password.

# Runtime (API) — Transaction pooler
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Migrations — Session / direct (falls back to DATABASE_URL if unset)
DATABASE_URL_MIGRATE=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

APP_ENV=pilot
SEED_MODULE=pilot

PUBLIC_APP_URL=https://demo.orbittech.co
CORS_ORIGINS=https://demo.orbittech.co

# Live overlay only (ignored for local published ports 9581/9501)
WEB_PORT=8080

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=pilot@orbittech.co

# Pilot reset cron: leave DISABLED once real companies register via Platform portal.
# See docs/guides/pilot-stack.md § Pilot reset policy
# PILOT_RESET_CRON=off
