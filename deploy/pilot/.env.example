# Copy to deploy/pilot/.env on the server and fill in values.
# Never commit deploy/pilot/.env
#
# Canonical always-on pilot uses Supabase Postgres (no Docker db):
#   docker compose -f docker-compose-pilot-supabase.yml \
#     -f deploy/pilot/docker-compose.live-supabase.yml \
#     --env-file deploy/pilot/.env up -d --build
#
# For a self-contained local Postgres stack instead, use docker-compose-pilot.yml
# + docker-compose.live.yml (no DATABASE_URL required — db is in compose).

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-openssl-or-secrets-token-hex-32

APP_ENV=pilot
# pilot = full sales dataset; super = Super Admin only (recommended for live)
SEED_MODULE=super
SUPER_ADMIN_EMAIL=aabdulghany@orbittech.co
SUPER_ADMIN_USERNAME=aabdulghany
# Leave empty to generate a one-time temp password (printed in migrate logs)
# SUPER_ADMIN_PASSWORD=

# Public URL users will open (include https:// if using TLS)
PUBLIC_APP_URL=https://pilot.orbittech.co

# Must match PUBLIC_APP_URL origin (comma-separated if multiple)
CORS_ORIGINS=https://pilot.orbittech.co,https://demo.orbittech.co

# Host port for nginx/web (Cloudflare Tunnel → http://localhost:WEB_PORT)
WEB_PORT=8080

# --- Supabase (required for live supabase compose) ---
# Runtime API — Transaction pooler :6543
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations — Session/direct :5432 (recommended; falls back to DATABASE_URL)
DATABASE_URL_MIGRATE=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=pilot@orbittech.co

# Pilot reset cron: leave DISABLED once real companies register via Platform portal.
# PILOT_RESET_CRON=off
