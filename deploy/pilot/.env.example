# Copy to deploy/pilot/.env on the server and fill in values.
# Never commit deploy/pilot/.env

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-openssl-or-secrets-token-hex-32

APP_ENV=pilot

# Public URL users will open (include https:// if using TLS)
# Showcase may still use https://demo.orbittech.co until DNS is renamed
PUBLIC_APP_URL=https://demo.orbittech.co

# Must match PUBLIC_APP_URL origin (comma-separated if multiple)
CORS_ORIGINS=https://demo.orbittech.co

# Host port for nginx/web
WEB_PORT=8080

# Optional: Postgres password override
# POSTGRES_PASSWORD=
